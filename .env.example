# ----------------------------------------------------------------------------------
# FinTwin-X configuration (copy to .env — never commit the real file)
# ----------------------------------------------------------------------------------

# ---- runtime -----------------------------------------------------------------------
# dev | staging | production
FINTWIN_ENV=dev
FINTWIN_DATA_DIR=./data
AS_OF=2026-08-31
RANDOM_SEED=42
N_SIMULATIONS=10000

# ---- API ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
FINTWIN_JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
RATE_LIMIT_PER_MINUTE=240
FINTWIN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FINTWIN_ENABLE_DEMO_USER=true
FINTWIN_ENABLE_SHAP=true

# ---- storage -----------------------------------------------------------------------
# Leave empty to use the embedded DuckDB + Parquet warehouse (default, zero-config).
DATABASE_URL=
# postgresql+psycopg://fintwin:fintwin@localhost:5432/fintwin
PGVECTOR_ENABLED=false

# ---- models / MLOps -----------------------------------------------------------------
MLFLOW_TRACKING_URI=
# http://localhost:5000

# ---- LLM (optional — the platform runs fully without it) ----------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---- RAG ----------------------------------------------------------------------------
# tfidf (offline default) | openai | sentence-transformers
FINTWIN_EMBEDDING_BACKEND=tfidf
